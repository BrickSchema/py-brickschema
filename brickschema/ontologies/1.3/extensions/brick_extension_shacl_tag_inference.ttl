                            sh:qualifiedValueShape [ sh:hasValue tag:Absolute ] ] ],
                _:has_Air_condition,
                _:has_Humidity_condition,
                _:has_Point_condition,
                _:has_Sensor_condition ;
            sh:object brick:Absolute_Humidity_Sensor ;
            sh:predicate rdf:type ;
            sh:subject sh:this ] ;
    sh:targetClass bsh:has_exactly_5_tags_condition .

