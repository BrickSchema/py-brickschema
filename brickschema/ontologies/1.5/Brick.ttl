brick:hasTag a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty,
        brick:Relationship ;
    rdfs:label "Has tag"@en ;
    owl:inverseOf brick:isTagOf ;
    skos:definition "The subject has the given tag"@en .
