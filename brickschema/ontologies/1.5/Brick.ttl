            sh:nodeKind sh:IRI ;
            sh:path brick:lastKnownValue ] ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Torque ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
