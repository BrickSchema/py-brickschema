        tag:Heat,
        tag:Pump,
        tag:Source,
        tag:Water .

brick:Plate_Heat_Exchanger a owl:Class,
        sh:NodeShape ;
    rdfs:label "Plate Heat Exchanger"@en ;
    rdfs:subClassOf brick:Heat_Exchanger ;
    skos:definition "A heat exchanger that transfers heat between two separate fluids through thin metal plates."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Exchanger ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:HX ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Heat ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Plate ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
