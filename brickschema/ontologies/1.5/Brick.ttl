    skos:definition "Water that is leaving a piece of equipment within a water system; contrasts with supply water which is water being supplied to the load side of the system."@en ;
    skos:narrower brick:Leaving_Building_Hot_Water,
        brick:Leaving_Chilled_Water,
        brick:Leaving_District_Hot_Water,
