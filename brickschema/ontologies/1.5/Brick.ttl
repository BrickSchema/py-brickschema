brick:Temperature_Deadband_Setpoint a owl:Class,
        sh:NodeShape ;
    rdfs:label "Temperature Deadband Setpoint"@en ;
    qudt:hasQuantityKind qudtqk:Temperature ;
    rdfs:subClassOf brick:Deadband_Setpoint,
        brick:Temperature_Setpoint ;
