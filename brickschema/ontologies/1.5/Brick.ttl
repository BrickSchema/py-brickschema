        tag:Differential,
        tag:Point,
        tag:Pressure,
        tag:Sensor,
        tag:Water ;
    brick:hasQuantity qudtqk:Pressure,
        brick:Differential_Pressure ;
    brick:hasSubstance brick:Chilled_Water .

brick:Chilled_Water_Differential_Temperature_Sensor a owl:Class,
