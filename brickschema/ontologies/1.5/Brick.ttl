        tag:Sensor,
        tag:Temperature,
        tag:Water ;
    brick:hasQuantity qudtqk:Temperature ;
    brick:hasSubstance brick:Condenser_Water .

brick:Cooling_Supply_Air_Temperature_Deadband_Setpoint a owl:Class,
        sh:NodeShape ;
