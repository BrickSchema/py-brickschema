        tag:Point,
        tag:Sensor,
        tag:Temperature,
        tag:Water ;
    brick:hasQuantity qudtqk:Temperature,
        brick:Differential_Temperature ;
    brick:hasSubstance brick:Water .

brick:Water_Valve a owl:Class,
