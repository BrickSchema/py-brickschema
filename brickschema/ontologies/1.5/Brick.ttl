            sh:description "The message of this exception event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "value" ;
            sh:path rec:value ],
        [ a sh:PropertyShape ;
            sh:class brick:Point ;
            sh:description "The brick:Point that emitted this exception." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "source point" ;
            sh:nodeKind sh:IRI ;
            sh:path rec:sourcePoint ] .

