brick:Cooling_Tower_Fan a owl:Class,
        sh:NodeShape ;
    rdfs:label "Cooling Tower Fan"@en ;
    rdfs:seeAlso <https://highperformancehvac.com/cooling-tower-fan/> ;
    rdfs:subClassOf brick:Fan ;
