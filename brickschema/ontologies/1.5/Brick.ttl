            sh:object tag:Control ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Security ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Access,
        tag:Control,
        tag:Equipment,
        tag:Security .

brick:Access_Reader a owl:Class,
        sh:NodeShape ;
    rdfs:label "Access Reader"@en ;
