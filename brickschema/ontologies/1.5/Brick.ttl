        [ a sh:TripleRule ;
            sh:object tag:Sensor ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Velocity ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
