    owl:deprecated true ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:name "Wi-Fi Signal Strength" ;
            sh:path rec:wifiSignalStrength ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:double ;
            sh:name "Battery Percentage" ;
            sh:path rec:batteryPercentage ] ;
    brick:deprecatedInVersion "1.4.0" ;
