            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Point ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Pump ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Status ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Off,
        tag:On,
        tag:Point,
        tag:Pump,
        tag:Status .

brick:Reactive_Energy_Sensor a owl:Class,
        sh:NodeShape ;
    rdfs:label "Reactive Energy Sensor"@en ;
    qudt:hasQuantityKind qudtqk:ElectricEnergy,
        qudtqk:Energy,
        qudtqk:ReactiveEnergy ;
    rdfs:subClassOf brick:Electric_Energy_Sensor ;
    skos:definition "Measures the integral of reactive power"@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Electric ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
