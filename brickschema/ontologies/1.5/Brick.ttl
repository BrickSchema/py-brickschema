        owl:IrreflexiveProperty,
        owl:ObjectProperty,
        brick:Relationship ;
    rdfs:label "Has part"@en ;
    owl:inverseOf brick:isPartOf ;
    skos:definition "The subject is composed in part of the entity given by the object"@en .

