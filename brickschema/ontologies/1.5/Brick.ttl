            sh:object tag:Power ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:System ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
