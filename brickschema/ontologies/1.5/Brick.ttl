        tag:Dry,
        tag:Equipment,
        tag:HVAC .

brick:Electric_Baseboard_Radiator a owl:Class,
        sh:NodeShape ;
    rdfs:label "Electric Baseboard Radiator"@en ;
    rdfs:subClassOf brick:Baseboard_Radiator,
