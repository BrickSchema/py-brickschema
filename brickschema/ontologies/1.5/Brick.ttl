            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Water ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Flow,
        tag:Point,
        tag:Setpoint,
        tag:Water ;
    brick:hasQuantity qudtqk:VolumeFlowRate ;
    brick:hasSubstance brick:Water .

tag:Boiler a brick:Tag ;
    rdfs:label "Boiler"@en ;
    brick:isAssociatedWith brick:Boiler,
        brick:Boiler_Command,
        brick:Condensing_Natural_Gas_Boiler,
        brick:Electric_Boiler,
        brick:Natural_Gas_Boiler,
        brick:Noncondensing_Natural_Gas_Boiler .

tag:Control a brick:Tag ;
    rdfs:label "Control"@en ;
    brick:isAssociatedWith brick:Access_Control_Equipment,
        brick:Access_Reader,
        brick:Control_Room,
        brick:Fire_Alarm_Control_Panel,
        brick:Fire_Control_Panel,
        brick:Motor_Control_Center .

tag:Distribution a brick:Tag ;
    rdfs:label "Distribution"@en ;
    brick:isAssociatedWith brick:Distribution_Frame,
        brick:Gas_Distribution,
        brick:IDF,
        brick:MDF,
        brick:Steam_Distribution,
        brick:Water_Distribution .

tag:Gain a brick:Tag ;
