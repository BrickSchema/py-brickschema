        tag:Discharge,
        tag:Humidity,
        tag:Point,
        tag:Relative,
        tag:Sensor,
        tag:Supply ;
    brick:hasQuantity qudtqk:PressureRatio,
        qudtqk:RelativeHumidity ;
    brick:hasSubstance brick:Discharge_Air,
        brick:Supply_Air .

brick:Supply_Air_Smoke_Detection_Alarm a owl:Class,
