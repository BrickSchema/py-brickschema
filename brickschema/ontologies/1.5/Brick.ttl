            sh:object tag:Temperature ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Alarm,
        tag:Low,
        tag:Point,
        tag:Return,
        tag:Temperature .

brick:Main_Disconnect_Switch a owl:Class,
        sh:NodeShape ;
    rdfs:label "Main Disconnect Switch"@en ;
    rdfs:subClassOf brick:Disconnect_Switch ;
    owl:equivalentClass brick:Building_Disconnect_Switch ;
    skos:definition "Primary service disconnect that isolates an entire building or service entrance from the upstream power source."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Disconnect ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Equipment ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
