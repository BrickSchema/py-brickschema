    skos:definition "cold chamber usually kept at a temperature of 22°F to 31°F (–5°C to –1°C), with high-volume air circulation."@en ;
    sh:rule [ a sh:TripleRule ;
            sh:object tag:Freezer ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
