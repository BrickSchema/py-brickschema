        [ a sh:TripleRule ;
            sh:object tag:Standby ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:CRAC,
        tag:Equipment,
        tag:Standby .

brick:Standby_Fan a owl:Class,
        sh:NodeShape ;
