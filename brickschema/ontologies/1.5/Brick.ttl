brick:feeds a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty,
        brick:Relationship ;
    rdfs:label "Feeds"@en ;
    owl:equivalentProperty rec:feeds ;
    owl:inverseOf brick:isFedBy ;
    skos:definition "The subject is upstream of the object in the context of some sequential process; some media is passed between them"@en .

brick:timestamp a rdf:Property,
        owl:DatatypeProperty,
        brick:Relationship ;
    rdfs:label "Timestamp"@en .

bsh:Electric_CurrentQuantityShape a sh:NodeShape ;
    rdfs:subClassOf bsh:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            skos:definition "The ambient temperature at which the current input was measured" ;
            sh:class bsh:TemperatureShape ;
            sh:path brick:ambientTemperatureOfMeasurement ] .

bsh:LastKnownValueShape a sh:NodeShape ;
    rdfs:subClassOf bsh:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:minCount 1 ;
            sh:path brick:timestamp ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path brick:value ] .

bsh:VoltageQuantityShape a sh:NodeShape ;
    rdfs:subClassOf bsh:ValueShape ;
    sh:property [ a sh:PropertyShape ;
            skos:definition "The ambient temperature at which the voltage was measured" ;
            sh:class bsh:TemperatureShape ;
            sh:path brick:ambientTemperatureOfMeasurement ] .

tag:AHU a brick:Tag ;
    rdfs:label "AHU"@en ;
    brick:isAssociatedWith brick:Air_Handling_Unit,
        brick:Dual_Duct_Air_Handling_Unit,
        brick:Rooftop_Unit .

tag:Access a brick:Tag ;
    rdfs:label "Access"@en ;
    brick:isAssociatedWith brick:Access_Control_Equipment,
        brick:Access_Reader,
        brick:Wireless_Access_Point .

tag:Adjust a brick:Tag ;
    rdfs:label "Adjust"@en ;
    brick:isAssociatedWith brick:Adjust_Sensor,
        brick:Temperature_Adjust_Sensor,
        brick:Warm_Cool_Adjust_Sensor .

tag:Angle a brick:Tag ;
    rdfs:label "Angle"@en ;
    brick:isAssociatedWith brick:Angle_Sensor,
        brick:Solar_Azimuth_Angle_Sensor,
        brick:Solar_Zenith_Angle_Sensor .

tag:Beam a brick:Tag ;
    rdfs:label "Beam"@en ;
    brick:isAssociatedWith brick:Active_Chilled_Beam,
        brick:Chilled_Beam,
        brick:Passive_Chilled_Beam .

tag:Breaker a brick:Tag ;
    rdfs:label "Breaker"@en ;
    brick:isAssociatedWith brick:Breaker_Panel,
        brick:Circuit_Breaker,
        brick:Main_Circuit_Breaker .

tag:Ceiling a brick:Tag ;
    rdfs:label "Ceiling"@en ;
    brick:isAssociatedWith brick:Cassette_Fan_Coil_Unit,
        brick:Ceiling_Fan,
        brick:Radiant_Ceiling_Panel .

tag:Charging a brick:Tag ;
    rdfs:label "Charging"@en ;
    brick:isAssociatedWith brick:Electric_Vehicle_Charging_Hub,
        brick:Electric_Vehicle_Charging_Port,
        brick:Electric_Vehicle_Charging_Station .

tag:Close a brick:Tag ;
    rdfs:label "Close"@en ;
    brick:isAssociatedWith brick:Close_Limit,
        brick:Open_Close_Command,
        brick:Open_Close_Status .

tag:Cold a brick:Tag ;
    rdfs:label "Cold"@en ;
    brick:isAssociatedWith brick:Cold_Box,
        brick:Cold_Deck,
        brick:Cold_Water_Storage_Tank .

tag:Conditioning a brick:Tag ;
    rdfs:label "Conditioning"@en ;
    brick:isAssociatedWith brick:Computer_Room_Air_Conditioning,
        brick:Heating_Ventilation_Air_Conditioning_System,
        brick:Zone_Air_Conditioning_Mode_Status .

tag:Controller a brick:Tag ;
    rdfs:label "Controller"@en ;
    brick:isAssociatedWith brick:BACnet_Controller,
        brick:Controller,
        brick:Modbus_Controller .

tag:Count a brick:Tag ;
    rdfs:label "Count"@en ;
    brick:isAssociatedWith brick:Occupancy_Count_Sensor,
