            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Thermal ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Collector,
        tag:Equipment,
        tag:PV,
        tag:Panel,
        tag:Solar,
        tag:Thermal .

