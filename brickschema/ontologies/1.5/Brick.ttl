        tag:Pressure,
        tag:Sensor,
        tag:Velocity ;
    brick:hasQuantity qudtqk:DynamicPressure,
        qudtqk:Pressure .

brick:Air_Wet_Bulb_Temperature_Sensor a owl:Class,
