        tag:Location,
        tag:Room,
        tag:Space ;
    brick:isReplacedBy rec:ExerciseRoom .

brick:Exhaust_Fan a owl:Class,
        sh:NodeShape ;
    rdfs:label "Exhaust Fan"@en ;
