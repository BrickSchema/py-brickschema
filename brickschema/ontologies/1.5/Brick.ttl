            sh:subject sh:this ] ;
    brick:hasAssociatedTag tag:Air,
        tag:Plenum,
        tag:Point,
        tag:Pressure,
        tag:Sensor,
        tag:Static,
        tag:Underfloor ;
    brick:hasQuantity qudtqk:Pressure .

