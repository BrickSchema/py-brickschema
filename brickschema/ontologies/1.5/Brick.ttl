            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Liquid ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Metering ;
            sh:predicate brick:hasTag ;
            sh:subject sh:this ],
        [ a sh:TripleRule ;
            sh:object tag:Refrigerant ;
